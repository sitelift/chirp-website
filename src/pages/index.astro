---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero";
import HowItWorks from "../components/HowItWorks";
import Meant from "../components/Meant";
import PanelShowcase from "../components/PanelShowcase";
import CostCompare from "../components/CostCompare";
import Bird from "../components/Bird";
import { SITE } from "../lib/site";

const windows = "M0 2.2 6.5 1.3v6.2H0zM7.3 1.2 16 0v7.5H7.3zM0 8.3h6.5v6.3L0 13.7zM7.3 8.3H16V16l-8.7-1.2z";

// From each vendor's own site, checked 2026-10-25. Monthly list prices.
const products = ["Chirp", "Wispr Flow", "Aqua Voice", "Willow", "Superwhisper", "Windows voice typing"];
const rows: { label: string; cells: string[] }[] = [
  { label: "Price", cells: ["Free", "$15/mo", "$12/mo", "$15/mo", "$8.49/mo", "Free"] },
  { label: "Open source", cells: ["Yes, MIT", "No", "No", "No", "No", "No"] },
  { label: "Pick your AI provider", cells: ["Anthropic, OpenAI or none", "No", "No", "No", "Yes, with your keys", "No"] },
  { label: "Speech recognition", cells: ["On your PC", "Their cloud", "Their cloud", "Their cloud", "Local or cloud", "Microsoft's cloud"] },
  { label: "Works offline", cells: ["Yes, without cleanup", "No", "No", "No, on Windows", "With local models", "No"] },
  { label: "AI cleanup and formatting", cells: ["Yes, with your key", "Yes", "Yes", "Yes", "Yes", "Copilot+ PCs only"] },
];

const faqs = [
  {
    q: "What does it cost?",
    a: "Chirp is free. Speech recognition runs on your PC, so it costs nothing to use. AI cleanup is optional: you add your own Anthropic or OpenAI key and pay them directly for the text Chirp sends, which with Claude Haiku 5.5 comes to a fraction of a cent per dictation.",
  },
  {
    q: "Do I need an API key?",
    a: "No. Without one, Chirp pastes what you said, punctuated by the speech model, with spoken commands like “new line” and “comma” turned into the real thing. Add a key when you want fillers removed, corrections resolved and text formatted for the app you're in.",
  },
  {
    q: "Do I need a graphics card?",
    a: "No. Chirp runs on your processor out of the box. If you have an NVIDIA GPU, it downloads GPU acceleration in the background and switches to it on the next restart, which makes speech recognition about three times faster. Allow about 10 GB of disk space for that download.",
  },
  {
    q: "Does it work offline?",
    a: "Speech recognition does, once the model has downloaded on first run. AI cleanup needs the internet; if it's offline, slow or your key stops working, Chirp pastes your words without cleanup instead of failing.",
  },
  {
    q: "Which apps does it work in?",
    a: "Any app where you can type: chat, email, documents, your editor, the terminal, a browser. Chirp pastes at your cursor and puts your clipboard back afterwards.",
  },
  {
    q: "Can I change the shortcuts?",
    a: "Yes. Hold to talk (Right Ctrl), hands-free (Left Ctrl + Win) and cancel (Esc) can each be set to any key or key combination.",
  },
  {
    q: "What does the AI provider see?",
    a: "Only text: the transcript, your Words list, and the name and title of the app you're dictating into, so it can format for it. Never audio, never screenshots, never what's around your cursor.",
  },
  {
    q: "Is there a Mac or Linux version?",
    a: "No. Chirp is built for Windows, and that's where all the effort goes.",
  },
];
---

<Base>
  <header class="fixed inset-x-0 top-0 z-50 bg-[#0a0908]/70 backdrop-blur-md">
    <nav class="mx-auto flex h-16 max-w-[1240px] items-center justify-between px-5 md:px-8">
      <a href="/" class="flex items-center gap-2 text-stone-100" aria-label="Chirp home">
        <Bird className="h-6 w-6 text-amber" />
        <span class="font-display text-[19px] font-semibold tracking-[-0.03em]">chirp</span>
      </a>
      <div class="flex items-center gap-1 md:gap-2">
        <a href="#how" class="hidden rounded-full px-3 py-2 text-[14px] text-stone-400 transition-colors duration-200 ease-out hover:text-stone-100 md:block">How it works</a>
        <a href="#pricing" class="hidden rounded-full px-3 py-2 text-[14px] text-stone-400 transition-colors duration-200 ease-out hover:text-stone-100 md:block">Pricing</a>
        <a href="#faq" class="hidden rounded-full px-3 py-2 text-[14px] text-stone-400 transition-colors duration-200 ease-out hover:text-stone-100 md:block">FAQ</a>
        <a href={SITE.github} class="hidden rounded-full px-3 py-2 text-[14px] text-stone-400 transition-colors duration-200 ease-out hover:text-stone-100 sm:block">GitHub</a>
        <a
          href={SITE.download}
          class="ml-2 flex items-center gap-2 rounded-full bg-stone-50 px-4 py-2 text-[14px] font-medium text-stone-950 transition-colors duration-200 ease-out hover:bg-white"
        >
          <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d={windows}></path></svg>
          Download
        </a>
      </div>
    </nav>
  </header>

  <main>
    <Hero client:load />

    <section id="how" class="mx-auto max-w-[1240px] scroll-mt-16 px-5 py-20 md:px-8 md:py-28">
      <h2 class="headline">Hold. Talk. Let go.</h2>
      <p class="lede">
        Most people speak around 150 words a minute and type around 52. Chirp is a small pill above your taskbar, with no window to
        open and nothing to switch to, so you can talk the moment a thought shows up.
      </p>
      <HowItWorks client:visible />
    </section>

    <section class="mx-auto max-w-[1240px] px-5 py-20 md:px-8 md:py-28">
      <h2 class="headline">It writes what you <span class="text-amber">meant</span>.</h2>
      <p class="lede">
        It drops the ums and false starts, keeps the last version when you correct yourself, and formats for the app you're in: an
        email in Gmail, a numbered list in Notion, code names in Cursor.
      </p>
      <Meant client:visible />
      <p class="mt-6 max-w-2xl text-[15px] leading-relaxed text-stone-500">
        This is AI cleanup, with your own Anthropic or OpenAI key. Turn it off and Chirp pastes what you said, with commands like
        “new line” and “question mark” converted.
      </p>
    </section>

    <section class="mx-auto grid max-w-[1240px] items-center gap-10 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="headline">Your names, spelled right.</h2>
        <p class="lede">
          Add a word once, whether it's a client, a product or a colleague called Thijs, and Chirp spells it exactly from then on.
          Snippets turn a short phrase into the whole thing: say “my address” and get your address.
        </p>
        <p class="mt-5 max-w-xl text-[17px] leading-relaxed text-stone-500">
          It all lives in the pill. Click the little tick above your taskbar and it opens right there.
        </p>
      </div>
      <PanelShowcase client:visible />
    </section>

    <section id="pricing" class="mx-auto max-w-[1240px] scroll-mt-16 px-5 py-20 md:px-8 md:py-28">
      <h2 class="headline">Pennies, not a subscription.</h2>
      <p class="lede">
        Most dictation apps send your voice to their servers and charge a monthly fee for it. Chirp turns speech into text on your
        PC, so the only cost is a tiny text call to the AI you pick, on your own key. Or none at all.
      </p>
      <CostCompare client:visible />

      <div class="mt-20 overflow-x-auto">
        <table class="w-full min-w-[860px] border-collapse text-left">
          <thead>
            <tr>
              <th class="w-[13rem] py-4 pr-4"></th>
              {
                products.map((p, i) => (
                  <th
                    class:list={[
                      "px-4 py-4 align-bottom text-[15px] font-semibold",
                      i === 0 ? "rounded-t-[18px] bg-white/[0.05] text-amber" : "text-stone-300",
                    ]}
                  >
                    {p}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r, ri) => (
                <tr class="border-t border-white/[0.07]">
                  <td class="py-4 pr-4 text-[15px] text-stone-400">{r.label}</td>
                  {r.cells.map((c, i) => (
                    <td
                      class:list={[
                        "px-4 py-4 text-[15px]",
                        i === 0 ? "bg-white/[0.05] font-medium text-stone-50" : "text-stone-400",
                        i === 0 && ri === rows.length - 1 && "rounded-b-[18px]",
                      ]}
                    >
                      {c}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-[15px] text-stone-500">
        From each company's own website on October 25, 2026. Monthly prices; most are a little cheaper billed yearly.
      </p>
    </section>

    <section class="mx-auto max-w-[1240px] px-5 py-20 md:px-8 md:py-28">
      <h2 class="headline">Open, and yours to keep.</h2>
      <div class="mt-14 grid gap-5 md:grid-cols-3">
        <div class="rounded-[28px] border border-white/[0.07] p-8">
          <p class="font-display text-[28px] font-semibold tracking-[-0.03em] text-stone-50">Open source</p>
          <p class="mt-3 text-[17px] leading-relaxed text-stone-400">
            Every line is on GitHub under the MIT license. See exactly how it works, change what you don't like, fork it if you
            want.
          </p>
        </div>
        <div class="rounded-[28px] border border-white/[0.07] p-8">
          <p class="font-display text-[28px] font-semibold tracking-[-0.03em] text-stone-50">No lock-in</p>
          <p class="mt-3 text-[17px] leading-relaxed text-stone-400">
            Use Anthropic or OpenAI, switch whenever you like, or skip AI entirely. No account to make, and your words, snippets and
            history stay on your PC.
          </p>
        </div>
        <div class="rounded-[28px] border border-white/[0.07] p-8">
          <p class="font-display text-[28px] font-semibold tracking-[-0.03em] text-stone-50">Fastest with cleanup off</p>
          <p class="mt-3 text-[17px] leading-relaxed text-stone-400">
            Speech becomes text in about a tenth of a second on an NVIDIA GPU, a third on a regular CPU. Short replies skip the AI on
            their own; with cleanup, expect about a second.
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-[1240px] px-5 py-20 md:px-8 md:py-28">
      <div class="rounded-[32px] bg-[#13120f] px-7 py-14 md:px-14 md:py-20">
        <h2 class="headline max-w-3xl">Help make it faster and smarter.</h2>
        <p class="lede">
          Chirp is built in the open, and two things get all the attention: how fast your words appear, and how right they are. If a
          dictation comes out slow or wrong, tell us what you said and what you got. That's the most useful thing you can do.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href={`${SITE.github}/issues/new`}
            class="rounded-full bg-stone-50 px-5 py-3 text-[16px] font-medium text-stone-950 transition-colors duration-200 ease-out hover:bg-white"
          >
            Report a slow or wrong dictation
          </a>
          <a href={SITE.github} class="rounded-full px-5 py-3 text-[16px] text-stone-300 ring-1 ring-white/15 transition-colors duration-200 ease-out hover:text-stone-50 hover:ring-white/30">
            Star it on GitHub
          </a>
        </div>
      </div>
    </section>

    <section id="faq" class="mx-auto max-w-[920px] scroll-mt-16 px-5 py-20 md:px-8 md:py-28">
      <h2 class="headline">Questions</h2>
      <div class="mt-12 divide-y divide-white/[0.08] border-y border-white/[0.08]">
        {
          faqs.map((f) => (
            <details class="group py-6">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[20px] font-medium tracking-[-0.01em] text-stone-100 [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="text-[22px] text-stone-500 transition-transform duration-200 ease-out group-open:rotate-45">+</span>
              </summary>
              <p class="mt-4 max-w-[46rem] text-[17px] leading-relaxed text-stone-400">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="flex flex-col items-center px-5 py-36 text-center md:py-48">
      <Bird className="h-14 w-14 text-amber" />
      <h2 class="headline mt-10">Stop typing.</h2>
      <p class="lede mx-auto">Free and open source, for Windows.</p>
      <a
        href={SITE.download}
        class="mt-10 flex items-center gap-3 rounded-full bg-amber px-7 py-4 text-[17px] font-semibold text-stone-950 transition-colors duration-200 ease-out hover:bg-[#f5c544]"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d={windows}></path></svg>
        Download for Windows
      </a>
    </section>
  </main>

  <footer class="mx-auto flex max-w-[1240px] items-center justify-between border-t border-white/[0.06] px-5 py-10 text-[14px] text-stone-500 md:px-8">
    <span class="flex items-center gap-2"><Bird className="h-4 w-4" /> chirp · MIT licensed</span>
    <div class="flex gap-6">
      <a href={SITE.github} class="hover:text-stone-200">GitHub</a>
      <a href={`${SITE.github}/issues`} class="hover:text-stone-200">Report an issue</a>
    </div>
  </footer>
</Base>
