---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero";
import Bird from "../components/Bird";
import { SITE } from "../lib/site";

const apps = ["Slack", "Gmail", "Word", "VS Code", "ChatGPT", "Notion", "Discord", "Outlook", "Teams", "Cursor"];
---

<Base>
  <header class="fixed inset-x-0 top-0 z-50 bg-[#0a0908]/70 backdrop-blur-md">
    <nav class="mx-auto flex h-16 max-w-[1240px] items-center justify-between px-5 md:px-8">
      <a href="/" class="flex items-center gap-2 text-stone-100" aria-label="Chirp home">
        <Bird className="h-6 w-6 text-[#F0B723]" />
        <span class="font-display text-[19px] font-semibold tracking-[-0.03em]">chirp</span>
      </a>
      <a
        href={SITE.download}
        class="flex items-center gap-2 rounded-full bg-stone-50 px-4 py-2 text-[14px] font-medium text-stone-950 transition-colors duration-200 ease-out hover:bg-white"
      >
        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"
          ><path d="M0 2.2 6.5 1.3v6.2H0zM7.3 1.2 16 0v7.5H7.3zM0 8.3h6.5v6.3L0 13.7zM7.3 8.3H16V16l-8.7-1.2z"></path></svg
        >
        Download
      </a>
    </nav>
  </header>

  <main>
    <Hero client:load />

    <!-- Any app -->
    <section class="mx-auto max-w-[1240px] px-5 py-28 md:px-8 md:py-40">
      <h2 class="headline">Talk in <span class="text-[#F0B723]">any</span> app.</h2>
      <p class="lede">If you can type there, you can talk there. Hold Right Ctrl, say it, let go. The text lands at your cursor.</p>
      <p class="mt-16 font-display text-[clamp(36px,5.6vw,80px)] font-semibold leading-[1.02] tracking-[-0.045em] text-stone-800">
        {
          apps.map((a, i) => (
            <>
              <span class:list={[i % 3 === 0 && "text-stone-300"]}>{a}</span>
              {i < apps.length - 1 && <span class="text-stone-800/60"> · </span>}
            </>
          ))
        }
      </p>
    </section>

    <!-- What you meant -->
    <section class="mx-auto max-w-[1240px] px-5 py-28 md:px-8 md:py-40">
      <h2 class="headline">It writes what<br />you <span class="text-[#F0B723]">meant</span>.</h2>
      <p class="lede">Ums, restarts and "no wait" disappear. Lists, punctuation and paragraphs show up.</p>
      <div class="mt-16 grid gap-6 md:grid-cols-2 md:gap-8">
        <div class="rounded-[28px] border border-white/[0.07] p-8 md:p-10">
          <p class="text-[15px] font-medium text-stone-500">You say</p>
          <p class="mt-5 font-mono text-[clamp(20px,2.1vw,27px)] leading-[1.5] text-stone-400">
            <s class="text-stone-600">um so</s> tell sam the launch is <s class="text-stone-600">tuesday no wait</s> wednesday at three
          </p>
        </div>
        <div class="rounded-[28px] bg-stone-50 p-8 md:p-10">
          <p class="text-[15px] font-medium text-stone-500">Chirp types</p>
          <p class="mt-5 text-[clamp(26px,2.8vw,38px)] font-medium leading-[1.25] tracking-[-0.025em] text-stone-950">
            Tell Sam the launch is Wednesday at 3.
          </p>
        </div>
      </div>
    </section>

    <!-- Private -->
    <section class="mx-auto max-w-[1240px] px-5 py-28 md:px-8 md:py-40">
      <h2 class="headline">Your voice never<br />leaves your <span class="text-[#F0B723]">PC</span>.</h2>
      <p class="lede">
        Speech becomes text on your computer, even offline. No account, no tracking. Optional AI cleanup uses your own
        Anthropic or OpenAI key and only ever sees text.
      </p>
    </section>

    <!-- Fast -->
    <section class="mx-auto max-w-[1240px] px-5 py-28 md:px-8 md:py-40">
      <p class="font-display text-[clamp(110px,22vw,320px)] font-semibold leading-[0.85] tracking-[-0.07em] text-stone-50">
        98<span class="text-[#F0B723]">ms</span>
      </p>
      <p class="lede">From your voice to text on an NVIDIA GPU. No GPU? It runs on your processor too.</p>
    </section>

    <!-- CTA -->
    <section class="flex flex-col items-center px-5 py-40 text-center md:py-56">
      <Bird className="h-16 w-16 text-[#F0B723]" />
      <h2 class="headline mt-10">Stop typing.</h2>
      <p class="lede mx-auto">Free and open source. For Windows.</p>
      <a
        href={SITE.download}
        class="mt-12 flex items-center gap-3 rounded-full bg-[#F0B723] px-8 py-4 text-[18px] font-semibold text-stone-950 transition-colors duration-200 ease-out hover:bg-[#f5c544]"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true"
          ><path d="M0 2.2 6.5 1.3v6.2H0zM7.3 1.2 16 0v7.5H7.3zM0 8.3h6.5v6.3L0 13.7zM7.3 8.3H16V16l-8.7-1.2z"></path></svg
        >
        Download for Windows
      </a>
      <a href={SITE.github} class="mt-6 text-[16px] text-stone-400 transition-colors duration-200 ease-out hover:text-stone-100">
        View the code on GitHub
      </a>
    </section>
  </main>

  <footer class="mx-auto flex max-w-[1240px] items-center justify-between px-5 py-10 text-[14px] text-stone-500 md:px-8">
    <span class="flex items-center gap-2"><Bird className="h-4 w-4 text-stone-500" /> chirp</span>
    <a href={SITE.github} class="hover:text-stone-200">GitHub</a>
  </footer>
</Base>
