---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero";
import Bird from "../components/Bird";
import { SITE } from "../lib/site";

const specs = [
  { value: "98.6", unit: "ms", label: "speech to text", note: "NVIDIA GPU, median" },
  { value: "317", unit: "ms", label: "on a plain CPU", note: "six threads, no GPU needed" },
  { value: "0", unit: "bytes", label: "of audio uploaded", note: "recognition runs on your PC" },
  { value: "$0", unit: "", label: "forever", note: "MIT licensed, no account" },
];

const pairs = [
  { said: "um so the launch is tuesday no wait wednesday", meant: "The launch is Wednesday." },
  { said: "first buy milk second call mom third ship it", meant: "1. Buy milk\n2. Call Mom\n3. Ship it" },
  { said: "can you make use auth retry twice question mark", meant: "Can you make useAuth retry twice?" },
  { said: "thanks again new paragraph best pieter", meant: "Thanks again.\n\nBest,\nPieter" },
];
---

<Base>
  <header class="fixed inset-x-0 top-0 z-50">
    <nav class="mx-auto flex h-16 max-w-[1240px] items-center justify-between px-5 md:px-8">
      <a href="/" class="flex items-center gap-2 text-stone-100" aria-label="Chirp home">
        <Bird className="h-6 w-6 text-[#F0B723]" />
        <span class="font-display text-[19px] font-semibold tracking-[-0.03em]">chirp</span>
      </a>
      <div class="flex items-center gap-2">
        <a
          href={SITE.github}
          class="hidden rounded-full px-3.5 py-2 text-[14px] text-stone-400 transition-colors duration-200 ease-out hover:text-stone-100 sm:block"
          >GitHub</a
        >
        <a
          href={SITE.download}
          class="flex items-center gap-2 rounded-full bg-stone-50 px-4 py-2 text-[14px] font-medium text-stone-950 transition-colors duration-200 ease-out hover:bg-white"
        >
          <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"
            ><path d="M0 2.2 6.5 1.3v6.2H0zM7.3 1.2 16 0v7.5H7.3zM0 8.3h6.5v6.3L0 13.7zM7.3 8.3H16V16l-8.7-1.2z"></path></svg
          >
          Download
        </a>
      </div>
    </nav>
  </header>

  <main>
    <section class="relative">
      <div class="grid-bg pointer-events-none absolute inset-0"></div>
      <Hero client:load />
    </section>

    <!-- Datasheet -->
    <section class="mx-auto max-w-[1240px] px-5 py-28 md:px-8 md:py-40">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-stone-500">Spec sheet</p>
      <h2 class="mt-4 max-w-3xl font-display text-[clamp(32px,4.4vw,60px)] font-semibold leading-[1] tracking-[-0.045em] text-stone-50">
        Fast enough that you stop <span class="font-serif font-normal italic tracking-[-0.02em] text-[#F0B723]">noticing</span> it.
      </h2>
      <div class="mt-16 grid grid-cols-1 border-t border-white/[0.08] sm:grid-cols-2 lg:grid-cols-4">
        {
          specs.map((s) => (
            <div class="border-b border-white/[0.08] py-8 sm:pr-8 lg:border-b-0 lg:border-r lg:px-8 lg:first:pl-0 lg:last:border-r-0">
              <div class="flex items-baseline gap-1.5">
                <span class="font-display text-[64px] font-semibold leading-none tracking-[-0.06em] text-stone-50 tabular-nums">
                  {s.value}
                </span>
                <span class="font-mono text-sm text-stone-500">{s.unit}</span>
              </div>
              <p class="mt-4 text-[15px] text-stone-200">{s.label}</p>
              <p class="mt-1 font-mono text-[12px] text-stone-500">{s.note}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-8 max-w-2xl font-mono text-[11px] leading-relaxed text-stone-600">
        Warm speech recognition on an RTX 4080 Super versus six CPU threads, measured on our benchmark corpus. AI cleanup is
        optional and adds about a second. We publish the harness, so you can measure your own machine.
      </p>
    </section>

    <!-- Said / meant -->
    <section class="border-y border-white/[0.06] bg-[#0d0c0b]">
      <div class="mx-auto max-w-[1240px] px-5 py-28 md:px-8 md:py-40">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-stone-500">What you said / what you meant</p>
        <h2 class="mt-4 max-w-3xl font-display text-[clamp(32px,4.4vw,60px)] font-semibold leading-[1] tracking-[-0.045em] text-stone-50">
          Ramble. Correct yourself. <span class="font-serif font-normal italic tracking-[-0.02em] text-[#F0B723]">Chirp keeps up.</span>
        </h2>
        <div class="mt-16 divide-y divide-white/[0.06]">
          {
            pairs.map((p) => (
              <div class="grid gap-3 py-7 md:grid-cols-2 md:gap-12">
                <p class="font-mono text-[14px] leading-relaxed text-stone-500">“{p.said}”</p>
                <p class="whitespace-pre-line text-[18px] leading-snug text-stone-100">{p.meant}</p>
              </div>
            ))
          }
        </div>
        <p class="mt-8 max-w-2xl font-mono text-[11px] leading-relaxed text-stone-600">
          Formatting like this comes from optional AI cleanup with your own key. With it off, spoken commands like “new line” and
          “question mark” still work.
        </p>
      </div>
    </section>

    <!-- Privacy flow -->
    <section class="mx-auto max-w-[1240px] px-5 py-28 md:px-8 md:py-40">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-stone-500">Where your voice goes</p>
      <h2 class="mt-4 max-w-3xl font-display text-[clamp(32px,4.4vw,60px)] font-semibold leading-[1] tracking-[-0.045em] text-stone-50">
        Your audio never leaves your PC. <span class="text-stone-500">Not as a policy. As a pipeline.</span>
      </h2>
      <ol class="mt-16 grid gap-px overflow-hidden rounded-[18px] bg-white/[0.06] md:grid-cols-4">
        <li class="bg-ink p-7">
          <p class="font-mono text-[11px] text-[#F0B723]">01 · on your PC</p>
          <p class="mt-3 text-[17px] text-stone-100">Microphone</p>
          <p class="mt-2 text-[14px] leading-relaxed text-stone-500">Recorded while you dictate. History stays on this computer.</p>
        </li>
        <li class="bg-ink p-7">
          <p class="font-mono text-[11px] text-[#F0B723]">02 · on your PC</p>
          <p class="mt-3 text-[17px] text-stone-100">Parakeet speech model</p>
          <p class="mt-2 text-[14px] leading-relaxed text-stone-500">Works offline after the first download.</p>
        </li>
        <li class="bg-ink p-7">
          <p class="font-mono text-[11px] text-stone-400">03 · optional, your key</p>
          <p class="mt-3 text-[17px] text-stone-100">AI cleanup</p>
          <p class="mt-2 text-[14px] leading-relaxed text-stone-500">
            Off, Anthropic or OpenAI. Sends your transcript, your Words list and the app and window title. Never audio.
          </p>
        </li>
        <li class="bg-ink p-7">
          <p class="font-mono text-[11px] text-[#F0B723]">04 · on your PC</p>
          <p class="mt-3 text-[17px] text-stone-100">Your cursor</p>
          <p class="mt-2 text-[14px] leading-relaxed text-stone-500">Pasted once, and your clipboard is put back.</p>
        </li>
      </ol>
      <p class="mt-6 font-mono text-[12px] text-stone-500">No analytics. No crash reporting. No account. Read the code if you don't believe us.</p>
    </section>

    <!-- CTA -->
    <section class="relative overflow-hidden border-t border-white/[0.06]">
      <div class="mx-auto flex max-w-[1240px] flex-col items-center px-5 py-32 text-center md:px-8 md:py-44">
        <Bird className="h-14 w-14 text-[#F0B723]" />
        <h2 class="mt-8 font-display text-[clamp(40px,6vw,88px)] font-semibold leading-[0.95] tracking-[-0.05em] text-stone-50">
          Stop typing<span class="text-[#F0B723]">.</span>
        </h2>
        <p class="mt-5 max-w-md text-[16px] leading-relaxed text-stone-400">
          Free for Windows x64. Works on CPU, faster with an NVIDIA GPU.
        </p>
        <a
          href={SITE.download}
          class="mt-10 flex items-center gap-2.5 rounded-full bg-stone-50 px-6 py-3.5 text-[16px] font-medium text-stone-950 transition-colors duration-200 ease-out hover:bg-white"
        >
          <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true"
            ><path d="M0 2.2 6.5 1.3v6.2H0zM7.3 1.2 16 0v7.5H7.3zM0 8.3h6.5v6.3L0 13.7zM7.3 8.3H16V16l-8.7-1.2z"></path></svg
          >
          Download for Windows
        </a>
        <a href={SITE.github} class="mt-5 text-[14px] text-stone-400 transition-colors duration-200 ease-out hover:text-stone-100">
          Steal our code (it's MIT) ↗
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/[0.06]">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-4 px-5 py-10 font-mono text-[12px] text-stone-600 sm:flex-row sm:items-center sm:justify-between md:px-8">
      <span>chirp · made by Pieter de Bruijn</span>
      <div class="flex gap-5">
        <a href={SITE.github} class="hover:text-stone-300">GitHub</a>
        <a href={`${SITE.github}/blob/v2/CHANGELOG.md`} class="hover:text-stone-300">Changelog</a>
      </div>
    </div>
  </footer>
</Base>
