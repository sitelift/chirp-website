---
// Chirp's art: skies for the flock to fly in, and the pill's own amber level
// bars as a pattern. Flat colour plus a little film grain; no images.
interface Props {
  variant: "dawn" | "amber" | "sky" | "night";
  class?: string;
}
const { variant, class: cls = "" } = Astro.props;

const dark = variant === "night";
const tone = dark ? "1" : "0";
const grain = `url("data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 ${tone}  0 0 0 0 ${tone}  0 0 0 0 ${tone}  0 0 0 1.1 -0.35'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>`,
)}")`;

const bg = {
  dawn: "linear-gradient(180deg, #e9eef0 0%, #f3ead6 55%, #f6d58a 100%)",
  amber: "#f0b723",
  sky: "linear-gradient(180deg, #c9dadc 0%, #e4ebe9 100%)",
  night: "linear-gradient(180deg, #1f1e1c 0%, #2b2925 100%)",
}[variant];

// Eleven bars, the shape of the listening pill, as a repeating mark.
const BARS = [0.5, 0.7, 0.85, 1, 0.8, 0.95, 0.75, 0.9, 0.65, 0.55, 0.4];
---

<div class={`${/\b(absolute|fixed)\b/.test(cls) ? "" : "relative"} overflow-hidden ${cls}`} style={`background:${bg}`} aria-hidden="true">
  {
    variant === "amber" && (
      <div class="absolute inset-x-0 bottom-0 flex h-[70%] items-end justify-between gap-[2.2%] px-[6%] opacity-[0.22]">
        {BARS.map((b) => (
          <span class="w-full rounded-t-full bg-[#6f5100]" style={`height:${b * 100}%`} />
        ))}
      </div>
    )
  }
  {
    variant === "night" && (
      <div class="absolute inset-x-0 bottom-[12%] flex h-[34%] items-center justify-center gap-[1.4%] opacity-[0.18]">
        {BARS.concat(BARS).map((b) => (
          <span class="w-[2.4%] rounded-full bg-amber" style={`height:${b * 100}%`} />
        ))}
      </div>
    )
  }
  <div class={`absolute inset-0 ${dark ? "mix-blend-screen" : "mix-blend-multiply"}`} style={`background-image:${grain};opacity:${dark ? 0.2 : 0.13}`}></div>
  <slot />
</div>
