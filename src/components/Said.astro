---
// The page's signature: what you'd actually say, filler struck through in
// amber as it scrolls into view, sitting above the headline Chirp would type.
interface Props {
  said: string;
  class?: string;
}
const { said, class: cls = "" } = Astro.props;
const tokens = said.split(" ").map((t) => ({ text: t.replace(/^~/, ""), drop: t.startsWith("~") }));
let k = 0;
---

<p class={`said flex items-start gap-3 font-serif text-[22px] leading-[1.35] text-ink/75 md:text-[27px] ${cls}`} data-said-line>
  <span class="mt-[0.3em] flex h-[0.75em] shrink-0 items-center gap-[3px]" aria-hidden="true">
    {[0.45, 0.8, 1, 0.65].map((h) => <span class="w-[3px] rounded-full bg-amber" style={`height:${h * 100}%`} />)}
  </span>
  <span>
    <span class="sr-only">Said: </span>“{
      tokens.map((t, i) => (
        <>
          {t.drop ? (
            <span class="said-drop relative inline-block" style={`--d:${k++ * 200}ms`}>
              {t.text}
            </span>
          ) : (
            t.text
          )}
          {i < tokens.length - 1 ? " " : ""}
        </>
      ))
    }”
  </span>
</p>

<style is:global>
  .said-drop {
    transition: color 300ms linear var(--d);
  }
  .said-drop::after {
    content: "";
    position: absolute;
    left: -0.05em;
    right: -0.05em;
    top: 55%;
    height: 4px;
    border-radius: 4px;
    background: #e3a50f;
    transform: translateY(-50%) scaleX(0);
    transform-origin: left;
    transition: transform 380ms var(--ease) calc(var(--d) + 250ms);
  }
  [data-said-line].is-in .said-drop {
    color: rgb(41 41 41 / 0.35);
  }
  [data-said-line].is-in .said-drop::after {
    transform: translateY(-50%) scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .said-drop,
    .said-drop::after {
      transition: none;
    }
  }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-in");
          io.unobserve(e.target);
        }
      }),
    { rootMargin: "0px 0px -20% 0px" },
  );
  document.querySelectorAll("[data-said-line]").forEach((el) => io.observe(el));
</script>
